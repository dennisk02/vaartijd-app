DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require&pgbouncer=true"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"

# Willekeurige lange random string, bv. gegenereerd met: openssl rand -base64 32
SESSION_SECRET=

# AFAS Profit App Connector (REST, OAuth2 client-credentials -- ingericht
# door Royaal/Willem van Melis, 24 aug 2026). Laat leeg om de AFAS-koppeling
# uit te schakelen -- de app werkt dan gewoon door, uren blijven op status
# PENDING. AFAS_TOKEN (het oude statische-token-mechanisme) is vervallen.
AFAS_ENVIRONMENT_ID=
AFAS_OAUTH_CLIENT_ID=
AFAS_OAUTH_CLIENT_SECRET=
# Naam van de UpdateConnector die de uren in AFAS moet ontvangen. Let op de
# Amerikaanse spelling ("Realization", niet "Realisation") -- bevestigd via
# AFAS' eigen metainfo-endpoint (27 aug 2026), zie HANDOVER.md §10.1.
AFAS_HOURS_CONNECTOR=PtRealization
# Vaste werksoort-/itemcode (ItCd) resp. boekingsstatus (StId) voor elke
# geboekte regel -- uit het voorbeeld van Royaal/Willem van Melis, mogelijk
# generiek sjabloon i.p.v. de daadwerkelijke code voor deze administratie.
# Verifieer voor het eerst live gebruik. Laat leeg voor de fallback-waarden
# "300"/"1" (zie integrations/afas/hoursSync.ts).
AFAS_HOURS_ITEM_CODE=
AFAS_HOURS_STATUS_ID=
# Gedeeld secret voor het extern (bv. cron) triggeren van /api/afas/sync
AFAS_SYNC_SECRET=
# Namen van de AFAS-UpdateConnectors voor de Rentman -> AFAS-pagina
# (/admin/rentman-afas, §10.8): projectaanmaak resp. gereed gemelde
# pakbonnen (waaruit AFAS zelf verkoopfacturen maakt -- geen directe
# verkoopfactuur-connector). Connectornamen bevestigd door Willem van
# Melis/Royaal (2 sep 2026): "PtProject" (geautoriseerd, metainfo geeft 200)
# resp. "FbDeliveryNote" (nog niet geautoriseerd, metainfo gaf op 2 sep 2026
# nog een 500). Laat leeg totdat de connector daadwerkelijk geautoriseerd is
# voor onze omgeving -- de checklist/verzendknoppen werken al, maar zetten
# elke poging tot die tijd op "wachtend" met een uitlegtekst i.p.v. echt te
# versturen.
AFAS_PROJECT_CONNECTOR=
AFAS_DELIVERY_NOTE_CONNECTOR=

# Shiftbase -- twee compleet gescheiden richtingen, zie HANDOVER.md §10.3:
# 1) vaarbemanning-import (River Roots-vloot, alleen lezend, werkend)
# 2) urenexport Vaartijd -> Shiftbase (schrijvend, nog ongeverifieerd/geblokkeerd)
SHIFTBASE_API_KEY=
# Laat leeg om de standaard Shiftbase-API-basis-URL te gebruiken.
SHIFTBASE_BASE_URL=
# Gedeeld secret voor het extern (bv. cron) triggeren van de vaarbemanning-
# import /api/shiftbase/crew-import (leest UIT Shiftbase, alleen lezend).
SHIFTBASE_IMPORT_SECRET=
# Gedeeld secret voor het extern (bv. cron) triggeren van de (nog
# geblokkeerde) urenexport /api/shiftbase/sync (schrijft NAAR Shiftbase).
SHIFTBASE_SYNC_SECRET=
# Zet pas op "true" nadat het /timesheets-endpoint en de veldnamen in
# integrations/shiftbase/hoursSync.ts zijn bevestigd via de verkenner -- tot die tijd
# blokkeert de app de (schrijvende) urenexport, ook al is SHIFTBASE_API_KEY
# geldig en werkt de vaarbemanning-import al wel.
SHIFTBASE_HOURS_EXPORT_ENABLED=

# Rentman (read-only projectsync). Token aanmaken in Rentman onder
# Instellingen -> API/Webshop -> API tokens.
RENTMAN_API_TOKEN=
# Gedeeld secret voor het extern (bv. cron) triggeren van /api/rentman/sync
RENTMAN_SYNC_SECRET=
# Vercel Cron Jobs sturen automatisch "Authorization: Bearer <CRON_SECRET>" mee
# als deze variabele is ingesteld -- zet 'm gelijk aan RENTMAN_SYNC_SECRET.
CRON_SECRET=
