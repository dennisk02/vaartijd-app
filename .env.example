DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require&pgbouncer=true"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"

# Willekeurige lange random string, bv. gegenereerd met: openssl rand -base64 32
SESSION_SECRET=

# AFAS Profit App Connector (REST). Laat leeg om de AFAS-koppeling uit te
# schakelen -- de app werkt dan gewoon door, uren blijven op status PENDING.
AFAS_ENVIRONMENT_ID=
AFAS_TOKEN=
# Naam van de UpdateConnector die de uren in AFAS moet ontvangen.
AFAS_HOURS_CONNECTOR=
# Gedeeld secret voor het extern (bv. cron) triggeren van /api/afas/sync
AFAS_SYNC_SECRET=

# Shiftbase (optioneel, voor de read-only verkenner op /admin/shiftbase en de
# ongeverifieerde urenexport -- zie README voor uitleg)
SHIFTBASE_API_KEY=
# Laat leeg om de standaard Shiftbase-API-basis-URL te gebruiken.
SHIFTBASE_BASE_URL=
# Gedeeld secret voor het extern (bv. cron) triggeren van /api/shiftbase/sync
SHIFTBASE_SYNC_SECRET=
# Zet pas op "true" nadat het /timesheets-endpoint en de veldnamen in
# lib/shiftbase/hoursSync.ts zijn bevestigd via de verkenner -- tot die tijd
# blokkeert de app de (schrijvende) urenexport, ook al is SHIFTBASE_API_KEY
# geldig en werkt lezen al wel.
SHIFTBASE_HOURS_EXPORT_ENABLED=
# Gedeeld secret voor het extern (bv. cron) triggeren van de vaarbemanning-
# import /api/shiftbase/import (andere richting dan SHIFTBASE_SYNC_SECRET
# hierboven -- dit leest UIT Shiftbase i.p.v. te schrijven).
SHIFTBASE_IMPORT_SECRET=

# Rentman (read-only projectsync). Token aanmaken in Rentman onder
# Instellingen -> API/Webshop -> API tokens.
RENTMAN_API_TOKEN=
# Gedeeld secret voor het extern (bv. cron) triggeren van /api/rentman/sync
RENTMAN_SYNC_SECRET=
# Vercel Cron Jobs sturen automatisch "Authorization: Bearer <CRON_SECRET>" mee
# als deze variabele is ingesteld -- zet 'm gelijk aan RENTMAN_SYNC_SECRET.
CRON_SECRET=
