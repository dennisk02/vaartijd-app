generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  EMPLOYEE
  ADMIN
}

enum Language {
  NL
  EN
  UK
  AR
}

/// Bedrijfsonderdeel waar een medewerker onder valt, gebruikt om de
/// projectenlijst (en schepenlijst) bij urenregistratie te beperken tot
/// relevante projecten. EVENTS_EVENTO = alle Rentman-afkomstige projecten
/// (administraties 02 Events + 21 Evento samen); RIVER_ROOTS = de
/// vaarbemanning-projecten/-schepen uit Shiftbase. Onderscheid op
/// `shiftbaseDepartmentId` (wel/niet ingevuld), niet op naam -- zie
/// lib/assignments.ts. De Events/Evento-onderverdeling zelf (voor Rentman-
/// administratieroutering 02/21, op basis van het "EVENTO - "-naamvoorvoegsel)
/// blijft een aparte, interne regel in lib/rentman/sync.ts en is geen
/// onderdeel meer van deze zichtbaarheidskeuze.
enum ProjectGroup {
  EVENTS_EVENTO
  RIVER_ROOTS
}

/// De 8 beheerbare onderdelen van /admin/*. Een medewerker die geen
/// volledige beheerder (Role.ADMIN) is kan hier los in toegewezen krijgen --
/// zie User.adminScopes en lib/dal.ts (requireAdminScope).
enum AdminScope {
  PROJECTS
  SHIPS
  USERS
  RENTMAN
  RENTMAN_FINANCIEEL
  SHIFTBASE
  AFAS
  RAPPORTAGES
}

enum SyncStatus {
  PENDING
  SYNCED
  ERROR
}

enum DayPart {
  DAY
  NIGHT
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
}

enum TimeEntryMode {
  TIMER
  MANUAL
  /// Geimporteerd uit Shiftbase (vaarbemanning-uren) -- zie lib/shiftbase/sync.ts.
  SHIFTBASE_IMPORT
}

model User {
  id                 String          @id @default(cuid())
  name               String
  email              String          @unique
  passwordHash       String
  role               Role            @default(EMPLOYEE)
  afasEmployeeNumber String?
  shiftbaseEmployeeId String?        @unique
  language           Language        @default(NL)
  active             Boolean         @default(true)
  canLogOccupancy    Boolean         @default(true)
  canLogMeals        Boolean         @default(true)
  canLogWaste        Boolean         @default(true)
  useDefaultProject  Boolean         @default(false)
  defaultProjectId   String?
  projectGroup       ProjectGroup    @default(EVENTS_EVENTO)
  /// Welke admin-onderdelen deze medewerker mag beheren zonder volledig
  /// beheerder (Role.ADMIN) te zijn -- zie lib/dal.ts (requireAdminScope).
  /// Volledige beheerders omzeilen deze lijst altijd (zie requireAdminScope).
  adminScopes        AdminScope[]    @default([])
  /// TOTP-2FA (verplicht voor alle accounts, zie proxy.ts). totpSecretPending
  /// bewaart het secret tijdens een nog onbevestigde instelprocedure, apart
  /// van totpSecret zodat de status nooit dubbelzinnig is: geen van beide =
  /// nooit gestart; alleen Pending = QR getoond maar nog niet bevestigd;
  /// totpSecret + totpEnabled = volledig ingesteld.
  totpEnabled        Boolean         @default(false)
  totpSecret         String?
  totpSecretPending  String?
  defaultProject     Project?        @relation("UserDefaultProject", fields: [defaultProjectId], references: [id], onDelete: SetNull)
  createdAt          DateTime        @default(now())
  timeEntries        TimeEntry[]
  shipOccupancies    ShipOccupancy[]
  mealCounts         MealCount[]
  foodWaste          FoodWaste[]
  daySubmissions     DaySubmission[]
  activeTimer        ActiveTimer?
  assignedProjects   Project[]       @relation("UserProjects")
  assignedShips      Ship[]          @relation("UserShips")
}

model Project {
  id               String        @id @default(cuid())
  name             String
  afasProjectCode  String?
  active           Boolean       @default(true)
  createdAt        DateTime      @default(now())
  timeEntries      TimeEntry[]
  activeTimers     ActiveTimer[]
  assignedUsers    User[]        @relation("UserProjects")
  defaultForUsers  User[]        @relation("UserDefaultProject")

  /// Herkomst uit Rentman (read-only sync) -- null betekent handmatig aangemaakt.
  rentmanSubprojectId String?    @unique
  rentmanProjectNumber String?
  rentmanProjectName   String?
  rentmanStatus        String?
  rentmanStartsAt      DateTime?
  rentmanEndsAt        DateTime?

  /// Automatisch aangemaakt "vaarbemanning"-project bij een Shiftbase-
  /// afdeling (1 project per schip) -- zie lib/shiftbase/sync.ts. Null
  /// betekent geen koppeling met Shiftbase.
  shiftbaseDepartmentId String? @unique
}

model Ship {
  id            String          @id @default(cuid())
  name          String
  code          String?
  capacity      Int?
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  occupancies   ShipOccupancy[]
  mealCounts    MealCount[]
  foodWaste     FoodWaste[]
  timeEntries   TimeEntry[]
  activeTimers  ActiveTimer[]
  assignedUsers User[]          @relation("UserShips")

  /// Herkomst uit Shiftbase (read-only sync, "department" = schip in de
  /// River Roots-vloot) -- null betekent handmatig aangemaakt. Nieuw
  /// gesyncte schepen komen inactief binnen; een beheerder activeert de
  /// daadwerkelijke boten (sommige Shiftbase-afdelingen zijn geen schip,
  /// bv. "Kantoor"). Zie lib/shiftbase/sync.ts.
  shiftbaseDepartmentId String? @unique
  shiftbaseDepartmentName String?
}

model TimeEntry {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  shipId         String?
  ship           Ship?         @relation(fields: [shipId], references: [id], onDelete: SetNull)
  date           DateTime
  startTime      DateTime?
  endTime        DateTime?
  breakMinutes   Int?
  mode           TimeEntryMode @default(MANUAL)
  hours          Decimal       @db.Decimal(5, 2)
  description    String?
  afasSyncStatus SyncStatus    @default(PENDING)
  afasSyncedAt   DateTime?
  afasError      String?
  shiftbaseSyncStatus SyncStatus @default(PENDING)
  shiftbaseSyncedAt   DateTime?
  shiftbaseError      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  /// Bij mode = SHIFTBASE_IMPORT: het bronrecord in Shiftbase (timesheet-id),
  /// zodat een herhaalde import dezelfde rij bijwerkt i.p.v. dupliceert.
  shiftbaseTimesheetId String? @unique

  @@index([userId, date])
  @@index([afasSyncStatus])
  @@index([shiftbaseSyncStatus])
}

/// Kleine generieke sleutel/waarde-tabel voor sync-status (bv. laatste
/// Rentman "modified"-tijdstempel voor incrementele sync).
model SyncState {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

/// Server-side "lopende timer" -- bestaat alleen zolang een dienst niet is
/// gestopt. Bij stoppen wordt hieruit een TimeEntry aangemaakt en deze rij
/// verwijderd.
model ActiveTimer {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  shipId    String?
  ship      Ship?    @relation(fields: [shipId], references: [id], onDelete: SetNull)
  startedAt DateTime
  createdAt DateTime @default(now())
}

model ShipOccupancy {
  id             String   @id @default(cuid())
  shipId         String
  ship           Ship     @relation(fields: [shipId], references: [id], onDelete: Cascade)
  date           DateTime
  dayPart        DayPart
  passengerCount Int
  crewCount      Int
  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now())

  @@unique([shipId, date, dayPart])
  @@index([createdById, date])
}

/// Aantal geserveerde maaltijden per type (geen gewicht) -- los van FoodWaste
/// omdat het een andere eenheid is (dataviz: nooit twee eenheden op één as).
model MealCount {
  id          String   @id @default(cuid())
  shipId      String
  ship        Ship     @relation(fields: [shipId], references: [id], onDelete: Cascade)
  date        DateTime
  mealType    MealType
  countServed Int
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@unique([shipId, date, mealType])
  @@index([createdById, date])
}

/// Voedselverspilling in kg per maaltijdtype.
model FoodWaste {
  id          String   @id @default(cuid())
  shipId      String
  ship        Ship     @relation(fields: [shipId], references: [id], onDelete: Cascade)
  date        DateTime
  mealType    MealType
  kg          Decimal  @db.Decimal(6, 2)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@unique([shipId, date, mealType])
  @@index([createdById, date])
}

/// Bundelt de registraties van één medewerker op één dag tot "ingediend".
model DaySubmission {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime
  submittedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([userId, date])
}

// ---------------------------------------------------------------------------
// Rentman financieel dashboard (omzet/facturatie-rapportage over Rentman-
// subprojecten). Losstaand van de operationele Project/Ship-sync hierboven --
// haalt elke nacht een verse, volledige set subprojecten + facturen op,
// specifiek voor deze rapportage. Zie lib/rentman/dashboardSync.ts.
// ---------------------------------------------------------------------------

/// Eén rij per Rentman-subproject (jaargescoped, elke nacht volledig ververst
/// -- rijen buiten de scope worden verwijderd). Dit is de ruwe brondata voor
/// alle 6 tabs van het financiële dashboard; alle KPI's/grafieken/tabellen
/// worden er bij het opbouwen van de pagina uit afgeleid (zie
/// lib/rentman/dashboardAggregate.ts) i.p.v. vooraf apart geaggregeerd te
/// worden -- bij ~800 rijen is dat in-memory triviaal snel, en het voorkomt
/// dat elke nieuwe doorsnede een eigen vooraf-berekende tabel nodig heeft.
model RentmanSubprojectSnapshot {
  id                   String    @id @default(cuid())
  rentmanSubprojectId  String    @unique
  name                 String
  rentmanProjectNumber String?
  status               String
  /// Projectomzet excl. btw (Rentmans `project_total_price`) -- 0 zodra het
  /// subproject geannuleerd is. Telt mee in "Totale projectomzet".
  revenue              Decimal   @db.Decimal(12, 2)
  /// Alleen gevuld bij status "Geannuleerd": het offertebedrag van vóór de
  /// annulering (Rentmans `project_total_price_cancelled`, dat -- in
  /// tegenstelling tot `project_total_price` -- niet op 0 gezet wordt).
  /// Bewust een apart veld i.p.v. hergebruik van `revenue`, zodat
  /// "gederfde omzet" nooit per ongeluk meetelt in de actieve omzettotalen.
  cancelledRevenue     Decimal?  @db.Decimal(12, 2)
  invoiced             Decimal   @db.Decimal(12, 2)
  /// Aanmaakmaand, "2026-01" .. "2026-12" -- de groepering die de meeste
  /// tabbladen gebruiken (uitzondering: Maandoverleg groepeert op
  /// factuurdatum, zie RentmanInvoicedMonthly).
  month                String
  createdAt            DateTime
  planperiodStart      DateTime?
  planperiodEnd        DateTime?
  /// Plaatsnaam van het subproject (Rentmans `location.visit_city`, anders
  /// `mailing_city`) -- "-" resp. null als er geen locatie/contact gekoppeld
  /// is. Puur ter weergave ("Locatie"-kolom), speelt geen rol in aggregaties.
  city                 String?
  /// Business unit: "EVENTO" (projectnaam begint met "EVENTO"), anders
  /// bepaald via het magazijn/stocklocation van het subproject
  /// (`asset_location_from`): /stocklocations/4 -> "M&R Utrecht",
  /// /stocklocations/1 (of onbekend/leeg, als fallback) -> "M&R Kampen".
  /// Zie dashboardSync.ts voor de exacte afleiding.
  businessUnit         String
  /// Categorie afgeleid van Rentmans project-type-naam (via
  /// project.project_type), met een sleutelwoord-classificatie: bevat
  /// "foodtruck" -> Foodtruck, "bbq" -> BBQ, "food"/"buffet" -> Catering,
  /// "verhuur" -> Verhuur, anders -> Overig (ook als project_type ontbreekt).
  /// Zie dashboardSync.ts.
  category             String
  computedAt           DateTime  @updatedAt

  @@index([month])
  @@index([status])
}

/// Eén rij per (factuur)maand -- apart van RentmanSubprojectSnapshot omdat dit
/// op factuurdatum groepeert i.p.v. project-aanmaakdatum (voor aansluiting
/// met AFAS/boekhouding, zie het "Maandoverleg"-scherm).
model RentmanInvoicedMonthly {
  id            String   @id @default(cuid())
  month         String   @unique
  invoicedExclVat Decimal @db.Decimal(12, 2)
  computedAt    DateTime @updatedAt
}

